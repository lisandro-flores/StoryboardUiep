---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Diagnóstico Comunitario Participativo — San José Buenavista | UIEP',
  description = 'Memoria documental del Diagnóstico Comunitario Participativo en San José Buenavista, Puebla, realizado junto con la brigada de Ingeniería Civil Sustentable de la UIEP.',
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${baseUrl}assets/uieplogo-transparent.png`} />

    <!-- Vista previa para compartir en WhatsApp comunitario -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${baseUrl}assets/foto-01.jpg`} />

    <!-- Tipografía editorial humana y documental: Alegreya (Huerta Tipográfica) + Source Sans 3 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alegreya:ital,wght@0,500..700;1,400..600&family=Source+Sans+3:ital,wght@0,400..700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-cream text-ink selection:bg-peach/45">
    <div class="paper-grain" aria-hidden="true"></div>
    <slot />
  </body>
</html>
